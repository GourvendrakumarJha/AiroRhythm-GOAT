# =============================================================================
#  AiroRhythm — environment configuration (placeholders only, never real secrets)
#
#  The single-file prototype needs NONE of this: it runs with an in-memory demo
#  backend. These keys are what the production version reads when DeviceRepository
#  is swapped for Supabase.
#
#  Rules:
#   * Only the ANON key and URL may reach the browser.
#   * SERVICE_ROLE and DEVICE_* secrets stay on a server / edge function. Never
#     ship them in Flutter code, in a URL, or in logs.
# =============================================================================

# --- Supabase (client-safe) ---------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server / edge functions ONLY — never in the app) ---------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Pairing ------------------------------------------------------------------
# Seconds a pairing code stays valid (2-5 minutes recommended in production).
PAIRING_CODE_TTL_SECONDS=180
# Wrong-attempt limit before a code is burned.
PAIRING_MAX_ATTEMPTS=5
# Redemptions allowed per user per window.
PAIRING_RATE_LIMIT_PER_10MIN=8

# --- Commands -----------------------------------------------------------------
# Server-side timeout before a command is reported as UNCONFIRMED (not success).
COMMAND_TIMEOUT_MS=4000
# Bounded retries for a desired-state command.
COMMAND_MAX_RETRIES=2

# --- Freshness ----------------------------------------------------------------
# Telemetry older than this is shown as "Last reported" / Stale, never as live.
TELEMETRY_STALE_AFTER_SECONDS=45
# Days of telemetry/history retained.
TELEMETRY_RETENTION_DAYS=7

# --- ESP32 device API (server-side; see docs/API-CONTRACT.md) -----------------
# Base URL of the trusted relay or gateway. Not reachable from the browser.
DEVICE_API_BASE_URL=https://gateway.example.internal
# Per-device HMAC secret used to sign commands. Provisioned out of band.
DEVICE_HMAC_SECRET=replace-me-server-side
# Clock skew tolerated on device signatures.
DEVICE_SIGNATURE_SKEW_SECONDS=60

# --- Cross-device sync (demo transport) ---------------------------------------
# Public relay used to link two devices in the same "room". No account, no key.
# Anyone who knows the room code can read the topic: demo transport only.
SYNC_RELAY_BASE_URL=https://ntfy.sh
# Topic prefix; the room code the user types is appended to it.
SYNC_TOPIC_PREFIX=airo-rhythm-
# How often each client polls the relay for new ops.
SYNC_POLL_INTERVAL_MS=2000

# --- Demo build only ----------------------------------------------------------
# Seeded in-memory account for the prototype. Remove before any deployment.
DEMO_USER_EMAIL=demo@airorhythm.app
DEMO_USER_PASSWORD=demo1234
